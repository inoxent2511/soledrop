# Sole Drop configuration. Every key is validated at start-up (lib/env.server.ts, lib/env.ts);
# leave a key empty to use its documented local fallback. Never commit real values.

# ── Runtime ──────────────────────────────────────────────────────────────────
DATA_DRIVER=mysql
LOCAL_DATA_DIR=.data/store
STORE_ID=00000000-0000-4000-8000-000000000001
# 32+ random characters in production (cookies, sealed TOTP secrets): openssl rand -base64 48
SESSION_SECRET=
# Optional alias: preserve the existing encryption key; both values must match if supplied.
AUTH_SECRET=
# true | false; false only for serving the production build over plain-HTTP loopback (qa/serve.mjs)
COOKIE_SECURE=
# Reverse proxies in front of the app that append to X-Forwarded-For
TRUSTED_PROXY_HOPS=1


# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Runtime canonical origin for server CSRF, redirects and mail links; match your public URL.
SITE_URL=http://localhost:3000
# PKR | USD | AED | GBP
NEXT_PUBLIC_DEFAULT_CURRENCY=PKR

# ── Email ────────────────────────────────────────────────────────────────────
# file (private local MIME sink) | console (memory/log summary) | smtp
EMAIL_PROVIDER=file
EMAIL_OUTBOX_DIR=.email-outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_HOURLY_LIMIT=100
EMAIL_FROM=Sole Drop <support@soledrop.store>

# ── Payments ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Bank transfer payee; the option is hidden in production until all three are set
BANK_NAME=
BANK_ACCOUNT_TITLE=
BANK_IBAN=

# ── Bot protection ───────────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Integrations ─────────────────────────────────────────────────────────────
# 16+ characters; protects /api/jobs/*
JOBS_SECRET=
CRON_SECRET=
# Comma-separated name:key pairs for /api/v1
API_KEYS=
# Comma-separated outbox webhook URLs
WEBHOOK_ENDPOINTS=
# Comma-separated flag=on|off overrides
FEATURE_FLAGS=
RESERVATION_TTL_MINUTES=15

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_DEMO_STAFF=off
# Optional comma-separated IPv4/IPv6 addresses or CIDRs, checked using trusted proxy metadata.
ADMIN_IP_ALLOWLIST=

# Optional customer auth capabilities; baseline screens stay unchanged while disabled.
AUTH_MAGIC_LINK=off
DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_SSL=false
DATABASE_ACQUIRE_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_TRANSACTION_TIMEOUT_MS=30000
STORAGE_DRIVER=local-disk
STORAGE_DIR=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
AUTH_EMAIL_VERIFICATION=off
# Optional OIDC provider; set all three together. Callback: /api/auth/oauth/callback.
# HTTPS issuer only. Uses PKCE, state, nonce and verified email; never auto-links by email.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
