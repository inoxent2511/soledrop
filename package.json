{
  "name": "soledrop",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "admin:migrate-catalogue": "node --conditions=react-server --import ./scripts/register.mjs scripts/migrate-catalogue.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/integration",
    "test:db": "vitest run tests/db",
    "db:seed": "node scripts/db-seed.mjs",
    "admin:docs": "node -e \"require('child_process').execFileSync(process.execPath,['node_modules/vitest/vitest.mjs','run','tests/unit/admin-permissions.test.ts'],{stdio:'inherit',env:Object.assign({},process.env,{WRITE_ADMIN_DOCS:'1'})})\"",
    "admin:create-owner": "node scripts/create-owner.mjs",
    "design:check": "node scripts/check-design.mjs",
    "qa:pixel": "node qa/pixel.mjs --base=http://127.0.0.1:3200",
    "qa:serve": "node qa/serve.mjs 3200",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:up": "node scripts/db-local.mjs up",
    "db:down": "node scripts/db-local.mjs down",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "db:seed-reset": "node scripts/db-reset.mjs",
    "db:test": "node scripts/db-test.mjs",
    "db:lint": "node scripts/db-lint.mjs",
    "db:bundle": "node scripts/db-bundle.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "mysql2": "^3.24.6",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "otplib": "^13.6.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
